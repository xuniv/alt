#!/bin/sh
# alt-pre-push-hook: installed by "alt hook install", removed by "alt hook uninstall".
#
# For every pushed tag that matches the glob below and is a valid build ref (the rules of build.yml's
# ref input), start "alt build <bid> <tag>" in the background as soon as the remote tag points at the
# pushed object (checked for up to ALT_HOOK_TIMEOUT seconds, default 600). A rejected push, for
# example of a tag that already exists on the remote at another commit, starts no build. The hook
# prints nothing, never fails and never delays the push. A pre-push hook that existed before was
# moved to pre-push.alt-chained; it runs first, with the same arguments and input, and its exit
# status still decides the push. Output of the background job, and a line for each skipped invalid
# tag, goes to ${ALT_CACHE_DIR:-~/.cache/xuniv-alt}/hook.log. The hook never passes --force, so
# pushing a tag of a withdrawn version (apps/<bid>/retracted.json on main) again builds nothing:
# "alt build" and build.yml refuse it. A tag of a new version builds as usual. For a tag that is new
# on the remote it passes --if-new, so a tag that already has a published release, or that the
# scheduled poll.yml is already building, starts no second build; a push that moves an existing tag
# always starts a build of the new commit.

ALT_BIN=@ALT_BIN@
ALT_BID=@ALT_BID@
ALT_TAG_GLOB=@ALT_TAG_GLOB@

hook_dir=$(dirname "$0")
# git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref
refs=$(cat)

if [ -x "$hook_dir/pre-push.alt-chained" ]; then
    if [ -n "$refs" ]; then
        printf '%s\n' "$refs" | "$hook_dir/pre-push.alt-chained" "$@"
    else
        "$hook_dir/pre-push.alt-chained" "$@" </dev/null
    fi
    status=$?
    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi
fi

# not rendered by the installer, or the alt checkout moved: do nothing
case "$ALT_BIN" in
    /*) ;;
    *) exit 0 ;;
esac
[ -x "$ALT_BIN" ] || exit 0
[ -n "$refs" ] || exit 0

umask 077
remote=${1:-origin}
timeout=${ALT_HOOK_TIMEOUT:-600}
interval=${ALT_HOOK_INTERVAL:-10}
case "$timeout" in ''|*[!0-9]*) timeout=600 ;; esac
case "$interval" in ''|*[!0-9]*) interval=10 ;; esac
[ "$interval" -ge 1 ] || interval=10
log_dir=${ALT_CACHE_DIR:-${HOME:-/nonexistent}/.cache/xuniv-alt}
# spelled out instead of A-Za-z0-9: a range in a bracket expression depends on the locale
alnum=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789

# runs detached: $1 alt, $2 bundle id, $3 tag, $4 remote, $5 timeout, $6 interval, $7 pushed object
# id (for an annotated tag the tag object, which ls-remote also lists for refs/tags/<tag>), $8 "new"
# when the remote had no such tag
waiter='
line=$(printf "%s\trefs/tags/%s" "$7" "$3")
waited=0
until git ls-remote "$4" "refs/tags/$3" 2>/dev/null | grep -qxF "$line"; do
    if [ "$waited" -ge "$5" ]; then
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) tag $3: the pushed object is not on the remote after $5 s;" \
            "no build started"
        exit 1
    fi
    sleep "$6"
    waited=$((waited + $6))
done
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) tag $3 pushed; starting alt build"
if [ "$8" = new ]; then
    exec "$1" build --if-new "$2" "$3"
fi
exec "$1" build "$2" "$3"
'

printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/?*) tag=${remote_ref#refs/tags/} ;;
        *) continue ;;
    esac
    case "$local_sha" in
        *[!0-9a-f]* | '') continue ;;
        *[!0]*) ;;
        *) continue ;;  # the tag is being deleted
    esac
    case "$tag" in
        $ALT_TAG_GLOB) ;;
        *) continue ;;
    esac
    case "$remote_sha" in
        *[!0]*) state=moved ;;  # the push moves a tag that the remote already has
        *) state=new ;;
    esac
    mkdir -p "$log_dir" 2>/dev/null || continue
    # the rules of build.yml's ref input: the run title "build <bid> <tag>" is public as soon as a
    # build is dispatched (alt build checks them again and also refuses denylist terms)
    case "$tag" in
        [!$alnum]* | *[!$alnum._/-]* | *..* | *//* | */.* | */ | *. | *.lock) valid=no ;;
        *) valid=yes ;;
    esac
    if [ "$valid" != yes ] || [ "${#tag}" -gt 128 ]; then
        printf '%s tag %s: not a valid build ref; no build started\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" >>"$log_dir/hook.log" 2>/dev/null
        continue
    fi
    nohup sh -c "$waiter" alt-pre-push "$ALT_BIN" "$ALT_BID" "$tag" "$remote" "$timeout" "$interval" \
        "$local_sha" "$state" </dev/null >>"$log_dir/hook.log" 2>&1 &
done
exit 0
